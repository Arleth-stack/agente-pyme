# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-al-azar
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# MySQL local (backend/iniciar_mysql.sh) o el de PythonAnywhere
MYSQL_NAME=agente_pyme
MYSQL_USER=agente
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# F2-08 Redacción con Gemini (llave gratis de aistudio.google.com)
GEMINI_API_KEY=

# F2-07 Stripe (modo de prueba)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_ID=

# F2-09 WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
