# Copia este archivo como .env y llena los valores. El .env nunca se sube a git.
SECRET_KEY=cambia-esto-por-una-cadena-larga-al-azar
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SITIO_URL=http://127.0.0.1:8000

# MySQL (utf8mb4). Si DATABASE_NAME está vacío se usa SQLite.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# Gemini (llave gratis de aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODELOS=gemini-3.5-flash,gemini-3.8-flash,gemini-flash-latest

# Stripe (modo de prueba)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_ID=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_AVISOS_A_DUENO=True

# CRM de Merkatics (opcional)
MERKATICS_CRM_URL=
MERKATICS_CRM_TOKEN=
